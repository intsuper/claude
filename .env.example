# Primary setup is GitHub Actions Secrets — add these names there
# (Settings -> Secrets and variables -> Actions). The reader runs in CI.
#
# This file is only for OPTIONAL local runs on your own machine:
#   cp .env.example .env      # .env is git-ignored, never committed

# --- Gorgias ---------------------------------------------------------------
# HTTP Basic auth: your login email + an API key from
# Settings -> REST API in your Gorgias admin.
GORGIAS_DOMAIN=yourbrand            # the subdomain in yourbrand.gorgias.com
GORGIAS_EMAIL=you@example.com
GORGIAS_API_KEY=

# --- Judge.me --------------------------------------------------------------
# Token-based: get the private API token from your Judge.me account
# (Integrations / API). shop_domain is your myshopify domain.
JUDGEME_API_TOKEN=
JUDGEME_SHOP_DOMAIN=yourbrand.myshopify.com

# --- Facebook (Graph API) --------------------------------------------------
# A Page access token (long-lived recommended) and the Page ID whose
# post comments you want to read.
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v19.0
