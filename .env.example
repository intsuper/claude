# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored, so your real keys never get committed.
#
#   cp .env.example .env
#
# When running on Claude Code on the web, set these same names as
# environment variables / secrets in your environment settings instead
# of using a .env file.

# --- Gorgias ---------------------------------------------------------------
# HTTP Basic auth: your login email + an API key from
# Settings -> REST API in your Gorgias admin.
GORGIAS_DOMAIN=yourbrand            # the subdomain in yourbrand.gorgias.com
GORGIAS_EMAIL=you@example.com
GORGIAS_API_KEY=

# --- Judge.me --------------------------------------------------------------
# Token-based: get the private API token from your Judge.me account
# (Integrations / API). shop_domain is your myshopify domain.
JUDGEME_API_TOKEN=
JUDGEME_SHOP_DOMAIN=yourbrand.myshopify.com

# --- Facebook (Graph API) --------------------------------------------------
# A Page access token (long-lived recommended) and the Page ID whose
# post comments you want to read.
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v19.0

# --- gethookd (existing MCP server) ---------------------------------------
# Moved out of .mcp.json so it isn't committed. Rotate the old token!
GETHOOKD_TOKEN=
